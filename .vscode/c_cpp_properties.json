{
    "configurations": [
        {
            "name": "AVR-Windows",
            "includePath": [
                "${env:AVR_ROOT}/avr/include",
                "${workspaceFolder}/AvrUtils/inc",
                "${workspaceFolder}/inc",
                "${workspaceFolder}/Utils/inc"
            ],
            "compilerPath": "${workspaceFolder}/3rd_party/avr8-gnu-toolchain-win32_x86_64/bin/avr-g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        },
        {
            "name": "AVR-Windows-Atmega32",
            "includePath": [
                "${env:AVR_ROOT}/avr/include",
                "${workspaceFolder}/AvrUtils/inc",
                "${workspaceFolder}/inc",
                "${workspaceFolder}/Utils/inc"
            ],
            "compilerArgs": [
                "-mmcu=atmega32"
            ],
            "defines": [
                "__AVR_ATmega32__",
                "F_CPU=16000000UL"
            ],
            "compilerPath": "${workspaceFolder}/3rd_party/avr8-gnu-toolchain-win32_x86_64/bin/avr-g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}